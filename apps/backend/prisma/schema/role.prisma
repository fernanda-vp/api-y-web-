model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isSystem  Boolean  @default(false)
  statusId  Int
  status    Status   @relation(fields: [statusId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]
}

model Permission {
  id        Int      @id @default(autoincrement())
  action    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  dependencies    PermissionDependency[] @relation("PermissionDependents")
  dependents      PermissionDependency[] @relation("PermissionRequiredBy")
}

model RolePermission {
  roleId       Int
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

/**
 * `permission` requiere que `dependsOn` también esté otorgado en el mismo rol.
 */
model PermissionDependency {
  permissionId Int
  permission   Permission @relation("PermissionDependents", fields: [permissionId], references: [id])
  dependsOnId  Int
  dependsOn    Permission @relation("PermissionRequiredBy", fields: [dependsOnId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([permissionId, dependsOnId])
}
