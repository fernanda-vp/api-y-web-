model JobTitle {
  id               Int        @id @default(autoincrement())
  name             String
  parentJobTitleId Int?
  parentJobTitle   JobTitle?  @relation("JobTitleHierarchy", fields: [parentJobTitleId], references: [id])
  children         JobTitle[] @relation("JobTitleHierarchy")
  statusId         Int
  status           Status     @relation(fields: [statusId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  positions Position[]
}
